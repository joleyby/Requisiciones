<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ReportingServices.ReportViewerControl.Winforms" Version="150.1652.0" />
    <Reference Include="System.Configuration" />
    <ProjectReference Include="..\Requisiciones.Entities\Requisiciones.Entities.csproj" />
    <ProjectReference Include="..\Requisiciones.Business\Requisiciones.Business.csproj" />
    <None Update="App.config" />
    <None Update="Reports\*.rdlc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="FormPrincipal.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FormPrincipal.Designer.cs"><DependentUpon>FormPrincipal.cs</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
  </ItemGroup>
</Project>
